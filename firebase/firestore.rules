rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function verified(uid) {
      return owns(uid) && (request.auth.token.get('email_verified', false) == true
        || request.auth.token.firebase.sign_in_provider in ['apple.com', 'google.com']);
    }
    function recent(uid) {
      return owns(uid) && request.auth.token.auth_time is int
        && timestamp.value(request.auth.token.auth_time * 1000) <= request.time + duration.value(30, 's')
        && request.time < timestamp.value(request.auth.token.auth_time * 1000) + duration.value(5, 'm');
    }
    function active(uid) {
      return verified(uid)
        && !exists(/databases/$(database)/documents/deletionMarkers/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.status == 'active';
    }
    function erasing(uid) {
      return recent(uid)
        && exists(/databases/$(database)/documents/deletionMarkers/$(uid))
        && (!exists(/databases/$(database)/documents/users/$(uid))
          || get(/databases/$(database)/documents/users/$(uid)).data.status == 'deleting');
    }
    function oldBackup(uid, backupId) {
      return active(uid)
        && backupId != get(/databases/$(database)/documents/users/$(uid)).data.activeBackupId
        && backupId != get(/databases/$(database)/documents/users/$(uid)).data.previousBackupId
        && get(/databases/$(database)/documents/users/$(uid)/backups/$(backupId)).data.createdAt
          < request.time - duration.value(1, 'd');
    }
    // Community publishing is fail-closed and separately enabled by an owner
    // operator. Clients can never approve, trust, or moderate their own posts.
    function communityReady() {
      let config = get(/databases/$(database)/documents/communityConfig/current).data;
      return config.enabled == true && config.moderationReady == true && config.rulesVersion == 1;
    }
    function boundedList(maximum) {
      return request.query.limit is int && request.query.limit > 0
        && request.query.limit <= maximum;
    }
    function moderator() {
      return request.auth != null && verified(request.auth.uid)
        && !exists(/databases/$(database)/documents/deletionMarkers/$(request.auth.uid))
        && get(/databases/$(database)/documents/communityModerators/$(request.auth.uid)).data.active == true;
    }
    function identityValid(data) {
      return data.schema == 1 && data.handle is string
        && data.handle.matches('^[a-z][a-z0-9_]{2,19}$')
        && (data.nickname == null || (data.nickname is string
          && data.nickname.matches('^[\\p{L}\\p{M}\\p{N} _-]{3,24}$')))
        && data.displayMode in ['handle', 'nickname']
        && (data.displayMode != 'nickname' || data.nickname != null)
        && data.acceptedPolicyVersion == '2026-11-05';
    }
    function submissionCounter(before, after, kind, id, maximum, seconds) {
      let lastAt = 'last' + kind + 'At';
      let lastId = 'last' + kind + 'Id';
      let window = kind == 'Post' ? 'postWindowAt' : 'reportWindowAt';
      let count = kind == 'Post' ? 'postsInWindow' : 'reportsInWindow';
      return after.diff(before).affectedKeys().hasOnly([lastAt, lastId, window, count])
        && after[lastAt] == request.time && after[lastId] == id
        && request.time >= before[lastAt] + duration.value(seconds, 's')
        && after[count] is int && after[count] >= 1 && after[count] <= maximum
        && ((request.time >= before[window] + duration.value(1, 'd')
          && after[window] == request.time && after[count] == 1)
        || (request.time < before[window] + duration.value(1, 'd')
          && after[window] == before[window] && after[count] == before[count] + 1));
    }
    function safeBody(body) {
      // Unicode letters/marks/numbers/punctuation/symbols include emoji and
      // international text, but exclude invisible format/bidi/control points.
      // Approval remains mandatory: a word list cannot recognize all abuse.
      return body is string && body.size() >= 1 && body.size() <= 1200
        && body.matches('^[\\p{L}\\p{M}\\p{N}\\p{P}\\p{S} \\n]+$')
        && !body.lower().matches('[\\s\\S]*(https?:|www\\.|@)[\\s\\S]*')
        && !body.lower().matches('[\\s\\S]*(^|[^a-z])(fuck|shit|bitch|nigger|nigga|cunt|orospu|siktir|sikik|amk|aq)([^a-z]|$)[\\s\\S]*');
    }
    function validReply(parentId, contentKey, uid) {
      let parent = get(/databases/$(database)/documents/communityComments/$(parentId)).data;
      return parent.status == 'approved' && parent.contentKey == contentKey
        && parent.parentId == null
        && !exists(/databases/$(database)/documents/deletionMarkers/$(parent.authorUid))
        && !exists(/databases/$(database)/documents/communityBlocks/$(uid)/authors/$(parent.authorUid))
        && !exists(/databases/$(database)/documents/communityBlocks/$(parent.authorUid)/authors/$(uid));
    }
    match /communityConfig/{id} {
      allow get: if id == 'current';
      allow list, write: if false;
    }
    match /communityModerators/{uid} {
      allow get: if owns(uid);
      allow list, write: if false;
    }
    match /communityHandles/{handle} {
      // Another person's handle reservation never discloses their UID.
      allow get: if request.auth != null && active(request.auth.uid)
        && (!exists(/databases/$(database)/documents/communityHandles/$(handle))
          || resource.data.uid == request.auth.uid);
      allow list: if false;
      allow create: if request.auth != null && active(request.auth.uid)
        && handle.matches('^[a-z][a-z0-9_]{2,19}$')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/communityProfiles/$(request.auth.uid)).data.handle == handle;
      allow update: if false;
      allow delete: if erasing(resource.data.uid)
        && !existsAfter(/databases/$(database)/documents/communityProfiles/$(resource.data.uid));
    }
    match /communityProfiles/{uid} {
      allow get: if (owns(uid) && (active(uid) || erasing(uid))) || moderator();
      allow list: if false;
      allow create: if active(uid) && identityValid(request.resource.data)
        && request.resource.data.keys().hasOnly(['schema', 'handle', 'nickname', 'displayMode',
          'createdAt', 'updatedAt', 'lastPostAt', 'lastPostId', 'postWindowAt', 'postsInWindow',
          'lastReportAt', 'lastReportId', 'reportWindowAt', 'reportsInWindow', 'acceptedPolicyVersion', 'acceptedPolicyAt'])
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.acceptedPolicyAt == request.time
        && request.resource.data.lastPostAt == timestamp.value(0) && request.resource.data.lastPostId == null
        && request.resource.data.postWindowAt == timestamp.value(0) && request.resource.data.postsInWindow == 0
        && request.resource.data.lastReportAt == timestamp.value(0) && request.resource.data.lastReportId == null
        && request.resource.data.reportWindowAt == timestamp.value(0) && request.resource.data.reportsInWindow == 0
        && getAfter(/databases/$(database)/documents/communityHandles/$(request.resource.data.handle)).data.uid == uid;
      allow update: if active(uid) && identityValid(request.resource.data) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'displayMode', 'updatedAt', 'acceptedPolicyVersion', 'acceptedPolicyAt'])
          && request.resource.data.updatedAt == request.time && request.resource.data.acceptedPolicyAt == request.time)
        || (communityReady() && submissionCounter(resource.data, request.resource.data, 'Post', request.resource.data.lastPostId, 20, 30)
          && !exists(/databases/$(database)/documents/communityComments/$(request.resource.data.lastPostId))
          && getAfter(/databases/$(database)/documents/communityComments/$(request.resource.data.lastPostId)).data.authorUid == uid)
        || (submissionCounter(resource.data, request.resource.data, 'Report', request.resource.data.lastReportId, 5, 60)
          && !exists(/databases/$(database)/documents/communityReports/$(request.resource.data.lastReportId))
          && getAfter(/databases/$(database)/documents/communityReports/$(request.resource.data.lastReportId)).data.reporterUid == uid)
      );
      allow delete: if erasing(uid)
        && !existsAfter(/databases/$(database)/documents/communityHandles/$(resource.data.handle));
    }
    match /communityComments/{commentId} {
      allow get: if resource.data.status == 'approved' || moderator()
        || (owns(resource.data.authorUid) && (active(resource.data.authorUid) || erasing(resource.data.authorUid)));
      allow list: if boundedList(50) && (resource.data.status == 'approved'
        || moderator() || (owns(resource.data.authorUid) && (active(resource.data.authorUid) || erasing(resource.data.authorUid))));
      allow create: if request.auth != null && active(request.auth.uid) && communityReady()
        && commentId.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.keys().hasOnly(['schema', 'contentKey', 'contentKind', 'authorUid',
          'authorName', 'body', 'parentId', 'isSpoiler', 'status', 'createdAt'])
        && request.resource.data.schema == 1 && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.contentKind == 'series'
        && request.resource.data.contentKey.matches('^tvmaze:show:[1-9][0-9]{0,9}$')
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time
        && request.resource.data.isSpoiler is bool && safeBody(request.resource.data.body)
        && get(/databases/$(database)/documents/communityProfiles/$(request.auth.uid)).data.acceptedPolicyVersion == '2026-11-05'
        && request.resource.data.authorName == (
          get(/databases/$(database)/documents/communityProfiles/$(request.auth.uid)).data.displayMode == 'nickname'
          ? get(/databases/$(database)/documents/communityProfiles/$(request.auth.uid)).data.nickname
          : '@' + get(/databases/$(database)/documents/communityProfiles/$(request.auth.uid)).data.handle)
        && getAfter(/databases/$(database)/documents/communityProfiles/$(request.auth.uid)).data.lastPostId == commentId
        && getAfter(/databases/$(database)/documents/communityProfiles/$(request.auth.uid)).data.lastPostAt == request.time
        && (request.resource.data.parentId == null || (request.resource.data.parentId is string
          && request.resource.data.parentId.matches('^[A-Za-z0-9]{20}$')
          && validReply(request.resource.data.parentId, request.resource.data.contentKey, request.auth.uid)));
      allow update: if false;
      allow delete: if owns(resource.data.authorUid)
        && (active(resource.data.authorUid) || erasing(resource.data.authorUid));
    }
    match /communityReports/{reportId} {
      allow get: if moderator();
      allow list: if moderator() && boundedList(50);
      allow create: if request.auth != null && active(request.auth.uid)
        && reportId.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.keys().hasOnly(['commentId', 'reporterUid', 'reason', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.commentId.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.reason in ['abuse', 'hate', 'sexual', 'spam', 'spoiler', 'other']
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/communityProfiles/$(request.auth.uid)).data.acceptedPolicyVersion == '2026-11-05'
        && get(/databases/$(database)/documents/communityComments/$(request.resource.data.commentId)).data.status == 'approved'
        && get(/databases/$(database)/documents/communityComments/$(request.resource.data.commentId)).data.authorUid != request.auth.uid
        && getAfter(/databases/$(database)/documents/communityProfiles/$(request.auth.uid)).data.lastReportId == reportId
        && getAfter(/databases/$(database)/documents/communityProfiles/$(request.auth.uid)).data.lastReportAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/communityReportRefs/$(reportId)).data.reportId == reportId;
      allow update: if false;
      // Blind cleanup is available only after fresh-auth deletion lock. A
      // reporter never gains read access to the private moderation queue.
      allow delete: if request.auth != null && erasing(request.auth.uid)
        && ((exists(/databases/$(database)/documents/communityReports/$(reportId))
            && resource.data.reporterUid == request.auth.uid)
          || (!exists(/databases/$(database)/documents/communityReports/$(reportId))
            && exists(/databases/$(database)/documents/users/$(request.auth.uid)/communityReportRefs/$(reportId))));
    }
    match /communityBlocks/{uid}/authors/{blockedUid} {
      allow get: if owns(uid) && (active(uid) || erasing(uid));
      allow list: if owns(uid) && (active(uid) || erasing(uid)) && boundedList(100);
      allow create: if active(uid) && blockedUid != uid && blockedUid.matches('^[A-Za-z0-9_-]{1,128}$')
        && request.resource.data.keys().hasOnly(['blockedUid', 'createdAt'])
        && request.resource.data.blockedUid == blockedUid && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/communityProfiles/$(blockedUid));
      allow update: if false;
      allow delete: if owns(uid) && (active(uid) || erasing(uid));
    }
    match /users/{uid} {
      allow get: if owns(uid);
      allow list: if false;
      allow create: if verified(uid)
        && !exists(/databases/$(database)/documents/deletionMarkers/$(uid))
        && request.resource.data.keys().hasOnly(['schema', 'status', 'revision', 'activeBackupId', 'previousBackupId', 'createdAt', 'updatedAt'])
        && request.resource.data.schema == 1 && request.resource.data.status == 'active'
        && request.resource.data.revision == 0 && request.resource.data.activeBackupId == null
        && request.resource.data.previousBackupId == null
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      // Both transitions have narrow field allowlists. Firebase documents can
      // never set a purchase entitlement or return a deleting account to active.
      allow update: if (
        active(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['revision', 'activeBackupId', 'previousBackupId', 'updatedAt'])
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.activeBackupId is string && request.resource.data.activeBackupId.size() == 36
        && request.resource.data.previousBackupId == resource.data.activeBackupId
        && request.resource.data.updatedAt == request.time
        && get(/databases/$(database)/documents/users/$(uid)/backups/$(request.resource.data.activeBackupId)).data.complete == true
      ) || (
        recent(uid) && resource.data.status in ['active', 'deleting']
        && request.resource.data.status == 'deleting'
        && request.resource.data.deletionRequestedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deletionRequestedAt'])
        && existsAfter(/databases/$(database)/documents/deletionMarkers/$(uid))
      );
      allow delete: if erasing(uid)
        // Older clients do not know about UGC. They must stop before deleting
        // Auth/root while a community identity (and its public content) exists.
        && !existsAfter(/databases/$(database)/documents/communityProfiles/$(uid))
        && getAfter(/databases/$(database)/documents/deletionMarkers/$(uid)).data.purgedAt == request.time;
      match /communityReportRefs/{reportId} {
        allow read: if owns(uid) && (active(uid) || erasing(uid));
        allow create: if active(uid)
          && request.resource.data.keys().hasOnly(['reportId', 'createdAt'])
          && request.resource.data.reportId == reportId && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/communityReports/$(reportId)).data.reporterUid == uid;
        allow update: if false;
        allow delete: if erasing(uid);
      }
      match /backups/{backupId} {
        allow read: if active(uid) || erasing(uid);
        allow create: if active(uid) && backupId.size() == 36
          && request.resource.data.keys().hasOnly(['schema', 'complete', 'chunks', 'bytes', 'sha256', 'createdAt'])
          && request.resource.data.schema == 1 && request.resource.data.complete == false
          && request.resource.data.chunks is int && request.resource.data.chunks >= 1 && request.resource.data.chunks <= 164
          && request.resource.data.bytes is int && request.resource.data.bytes > 0 && request.resource.data.bytes <= 67108864
          && request.resource.data.sha256 is string && request.resource.data.sha256.size() == 64
          && request.resource.data.createdAt == request.time;
        allow update: if active(uid) && resource.data.complete == false && request.resource.data.complete == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['complete']);
        allow delete: if erasing(uid) || oldBackup(uid, backupId);
        match /chunks/{chunkId} {
          allow read: if active(uid) || erasing(uid);
          allow create: if active(uid) && backupId.size() == 36
            && chunkId.matches('^[0-9]{1,3}$') && int(chunkId) < 164
            && get(/databases/$(database)/documents/users/$(uid)/backups/$(backupId)).data.complete == false
            && request.resource.data.keys().hasOnly(['payload']) && request.resource.data.payload is bytes
            && request.resource.data.payload.size() > 0 && request.resource.data.payload.size() <= 409600;
          allow update: if false;
          allow delete: if erasing(uid) || oldBackup(uid, backupId);
        }
      }
    }
    match /deletionMarkers/{uid} {
      allow get: if owns(uid);
      allow list: if false;
      allow create: if recent(uid)
        && request.resource.data.keys().hasOnly(['startedAt', 'nonce'])
        && request.resource.data.startedAt == request.time
        && request.resource.data.nonce is string && request.resource.data.nonce.size() == 44
        && (!existsAfter(/databases/$(database)/documents/users/$(uid))
          || getAfter(/databases/$(database)/documents/users/$(uid)).data.status == 'deleting');
      allow update: if (
        erasing(uid) && !existsAfter(/databases/$(database)/documents/users/$(uid))
        && !existsAfter(/databases/$(database)/documents/communityProfiles/$(uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['purgedAt'])
        && request.resource.data.purgedAt == request.time
      ) || (
        // After Auth deletion the app no longer has an authenticated user. The
        // private random proof can only complete this already-erased marker.
        !exists(/databases/$(database)/documents/users/$(uid))
        && resource.data.purgedAt is timestamp && !('authDeletedAt' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authDeletedAt', 'completionProof'])
        && request.resource.data.completionProof == resource.data.nonce
        && request.resource.data.authDeletedAt == request.time
      );
      // After all old ID tokens have expired, a known marker may be removed
      // without signing back in. No anonymous reads/lists or user-data deletes.
      allow delete: if resource.data.authDeletedAt is timestamp
        && request.time > resource.data.authDeletedAt + duration.value(2, 'h')
        && !exists(/databases/$(database)/documents/users/$(uid));
    }
    match /{document=**} { allow read, write: if false; }
  }
}
